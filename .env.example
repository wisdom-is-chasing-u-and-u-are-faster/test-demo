# Environment Configuration for Automated Loan Approval System (ALAS)
# Copy to .env for local runtime execution

# Database Configuration (Dual-mode: SQLite fallback or PostgreSQL)
DATABASE_URL=sqlite:///./alas.db
# DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}
DB_POOL_SIZE=10

# Redis Cache & Sliding Window Idempotency
REDIS_URL=redis://localhost:6379/0

# Server Ports & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Security & JWT Tokens
JWT_SECRET_KEY=alas-super-secret-enterprise-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# External Bureau Gateways (Simulated / Staging)
EXPERIAN_GATEWAY_URL=https://api.experian.sandbox.bank.internal/v1
EQUIFAX_GATEWAY_URL=https://api.equifax.sandbox.bank.internal/v1
BUREAU_TIMEOUT_MS=1500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# Multi-Channel Notification Dispatcher
NOTIFICATION_ENABLED=true
EMAIL_DISPATCHER_HOST=smtp.sandbox.bank.internal
SMS_DISPATCHER_ENABLED=true
